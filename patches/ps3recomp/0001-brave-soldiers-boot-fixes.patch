+/* ---------------------------------------------------------------------------
+ * INLINE_ARRAY
+ *
+ * The enabled attributes are packed back to back in index order, each element
+ * its natural size (CMP is one 4-byte word); the vertex stride is the format
+ * register's stride when set, else the packed size.
+ * -----------------------------------------------------------------------*/
+static u8  s_inline_buf[256 * 1024];
+static u32 s_inline_len;
+
+static u32 inline_elem_bytes(const rsx_vertex_attrib* a)
+{
+    static const u8 tb[8] = { 0, 2, 4, 2, 1, 2, 4, 1 };   /* S1 F SF UB S32K CMP UB256 */
+    if ((a->type & 7) == 6) return 4;
+    return (u32)a->size * tb[a->type & 7];
+}
+
+static void inline_array_draw(rsx_state* state)
+{
+    u32 offs[RSX_MAX_VERTEX_ATTRIBS], strides[RSX_MAX_VERTEX_ATTRIBS];
+    u32 packed = 0, stride = 0;
+    for (u32 i = 0; i < RSX_MAX_VERTEX_ATTRIBS; i++) {
+        const rsx_vertex_attrib* a = &state->vertex_attribs[i];
+        if (!a->enabled) continue;
+        packed += inline_elem_bytes(a);
+        if (!stride && a->stride) stride = a->stride;
+    }
+    if (!stride) stride = packed;
+    if (!packed || !stride) return;
+    u32 count = s_inline_len / stride;
+    /* Correlate immediate UI/composite draws with their actual destination. */
+    { static int trace = -1; if (trace < 0) trace = getenv("RSX_INLINE_TRACE") != NULL;
+      if (trace) fprintf(stderr, "[INLINE_TARGET] offA=0x%X offB=0x%X target=0x%X size=%ux%u verts=%u bytes=%u\n",
+          state->surface_color_offset[0], state->surface_color_offset[1], state->color_target,
+          state->surface_clip_w, state->surface_clip_h, count, s_inline_len); }
+    /* Keep the payload dump inside the same bounded diagnostic gate: the
+     * saturating counter stays at eight after logging, so testing n <= 8
+     * separately would print every later draw. */
+    { static int n = 0, trace = -1;
+      if (trace < 0) trace = getenv("RSX_INLINE_TRACE") != NULL;
+      if (trace && PS3_LOG_FIRST(n, 8)) {
+        fprintf(stderr, "[RSX] INLINE_ARRAY prim=%u bytes=%u stride=%u packed=%u verts=%u\n",
+                state->primitive_type, s_inline_len, stride, packed, count);
+        fprintf(stderr, "[RSX]   attribs:");
+        for (u32 i = 0; i < RSX_MAX_VERTEX_ATTRIBS; i++)
+            if (state->vertex_attribs[i].enabled)
+                fprintf(stderr, " a%u(t%u x%u s%u)", i, state->vertex_attribs[i].type,
+                        state->vertex_attribs[i].size, state->vertex_attribs[i].stride);
+        fprintf(stderr, " words:");
+        for (u32 k = 0; k < s_inline_len / 4u && k < 14; k++) {
+            u32 w = ((u32)s_inline_buf[k*4] << 24) | ((u32)s_inline_buf[k*4+1] << 16) |
+                    ((u32)s_inline_buf[k*4+2] << 8) | s_inline_buf[k*4+3];
+            float f; memcpy(&f, &w, 4);
+            fprintf(stderr, " %g", f);
+        }
+        fprintf(stderr, "\n");
+        } }
+    if (!count || !s_backend || !s_backend->draw_arrays) return;
+
+    u32 cur = 0;
+    for (u32 i = 0; i < RSX_MAX_VERTEX_ATTRIBS; i++) {
+        rsx_vertex_attrib* a = &state->vertex_attribs[i];
+        offs[i] = a->offset; strides[i] = a->stride;
+        if (!a->enabled) continue;
+        a->offset = cur;
+        a->stride = stride;
+        cur += inline_elem_bytes(a);
+    }
+    state->inline_base = s_inline_buf;
+    state->inline_len  = s_inline_len;
+    s_backend->draw_arrays(s_backend->userdata, state->primitive_type, 0, count);
+    state->inline_base = NULL;
+    state->inline_len  = 0;
+    for (u32 i = 0; i < RSX_MAX_VERTEX_ATTRIBS; i++) {
+        state->vertex_attribs[i].offset = offs[i];
+        state->vertex_attribs[i].stride = strides[i];
+    }
+}
+
 /* ---------------------------------------------------------------------------
  * Main method dispatch
  * -----------------------------------------------------------------------*/
@@ -612,6 +691,11 @@ int rsx_process_method(rsx_state* state, u32 method, u32 data)
 
     /* Color mask */
     if (method == NV4097_SET_COLOR_MASK) {
