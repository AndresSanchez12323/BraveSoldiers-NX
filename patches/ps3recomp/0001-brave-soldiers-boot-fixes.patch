+     * cannot hide a later, unsupported draw command. */
+    static int s_unknown_enabled = -1;
+    static unsigned char s_unknown_seen[0x10000];
     static int s_unknown_count = 0;
-    if (s_unknown_count < 50) {
+    if (s_unknown_enabled < 0) {
+#ifndef NDEBUG
+        s_unknown_enabled = 1;
+#else
+        s_unknown_enabled = getenv("RSX_UNK") != NULL;
+#endif
+    }
+    if (s_unknown_enabled && s_unknown_count < 256 &&
+        (method >= sizeof(s_unknown_seen) || !s_unknown_seen[method])) {
+        if (method < sizeof(s_unknown_seen)) s_unknown_seen[method] = 1;
         printf("[RSX] unknown method 0x%04X = 0x%08X\n", method, data);
         s_unknown_count++;
     }
-#endif
 
     return -1;
 }
